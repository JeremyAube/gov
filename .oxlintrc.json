{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "ignoreRestSiblings": true
      }
    ],
    "no-undef": "error"
  },
  "env": {
    "builtin": true,
    "worker": true
  },
  "overrides": [
    {
      "files": ["src/client.js", "src/pdf.js"],
      "env": {
        "browser": true
      }
    },
    {
      "files": ["scripts/*.mjs", "test/*.js"],
      "env": {
        "node": true
      }
    }
  ]
}
